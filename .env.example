# GEMINI_API_KEY: Required by the serverless function at /api/strategy-tips.ts.
# This key is read server-side only (process.env.GEMINI_API_KEY inside the
# Vercel function) and is never bundled into client-side JavaScript.
#
# Local dev: copy this file to .env.local and add `vercel dev` to run the
# serverless function alongside the Vite dev server.
# Production: set this in the Vercel project dashboard under
# Settings -> Environment Variables, or via `vercel env add GEMINI_API_KEY`.
GEMINI_API_KEY="MY_GEMINI_API_KEY"
